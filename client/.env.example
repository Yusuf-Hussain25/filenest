# Copy to client/.env. Only VITE_ values are exposed to the browser, so no secrets here.

# URL of the Filenest API server (server/)
VITE_BASE_URL="http://localhost:3000"

# Optional: show "Explore with a demo account" on the login page.
# Use the same email as DEMO_EMAIL in server/.env (created by `npm run seed`).
VITE_DEMO_EMAIL=""

# Optional: how files reach storage. "direct" (default) uploads straight to the bucket with
# presigned URLs (needs bucket CORS: `npm run bucket` sets it). "server" sends files through
# the API instead (max 100 MB each).
VITE_UPLOAD_MODE="direct"
