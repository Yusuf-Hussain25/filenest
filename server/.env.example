# Copy to server/.env and fill in. Never commit server/.env.

# development | production (production makes the auth cookie Secure + SameSite=None)
NODE_ENV="development"
PORT=3000

# Secret used to sign login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=""

# Comma-separated list of browser origins allowed to call the API
ORIGINS="http://localhost:5173"

# Limits (in bytes)
MAX_FILE_SIZE=1073741824       # 1 GB per file (uploads through the API stay capped at 100 MB)
MAX_STORAGE_PER_USER=1073741824 # 1 GB per account

# Postgres connection string.
# Local (npm run services): the default below works as is.
# Neon: console.neon.tech -> your project -> Connect -> copy the connection string
DATABASE_URL="postgres://postgres:postgres@localhost:5435/filenest"

# S3-compatible object storage.
# Local (npm run services): the defaults below work as is.
# Cloudflare R2 (free tier): dash.cloudflare.com -> R2 -> Create bucket, then
#   R2 -> Manage API tokens -> Create API token (Object Read & Write) -> copy the
#   Access Key ID, Secret Access Key and the S3 endpoint (https://<account>.r2.cloudflarestorage.com),
#   and set AWS_REGION="auto"
AWS_ENDPOINT_URL_S3="http://localhost:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="filenest"

# Demo data (npm run seed). Setting DEMO_EMAIL also enables POST /api/auth/demo, which the
# "Explore with a demo account" button uses (set VITE_DEMO_EMAIL in client/.env to show it).
# DEMO_PASSWORD lets you log in to the demo account by hand.
DEMO_EMAIL="demo@filenest-demo.dev"
DEMO_PASSWORD=""
# Password for the other seeded accounts (@filenest-demo.dev)
SEED_PASSWORD=""

# Largest ZIP download (bytes)
ZIP_MAX_BYTES=2147483648 # 2 GB
